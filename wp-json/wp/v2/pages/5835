y\">1,695<\/span>*\r\n        <\/div>\r\n\r\n        <div class=\"note\">\r\n            * When compared to a commission of 5%, based on our 1% listing fee and a commission of 2.5% to the co-operating brokerage (recommended but not required).\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <script>\r\n        const homeValueInput = document.getElementById('homeValueInput');\r\n        const homeValueSlider = document.getElementById('homeValueSlider');\r\n        const savingsDisplay = document.getElementById('savingsDisplay');\r\n\r\n        function calculateSavings(homeValue) {\r\n            \/\/ Custom calculation for savings based on home value\r\n            if (homeValue === 100000) return 1695;\r\n            else if (homeValue === 150000) return 2542.5;\r\n            else if (homeValue === 200000) return 3390;\r\n            else if (homeValue === 250000) return 4237.5;\r\n            else if (homeValue === 300000) return 5085;\r\n            else if (homeValue === 350000) return 5932.5;\r\n            else if (homeValue === 400000) return 6780;\r\n            else if (homeValue === 450000) return 7627.5;\r\n            else if (homeValue === 500000) return 8475;\r\n            else if (homeValue === 3000000) return 50850;\r\n\r\n            \/\/ General calculation for intermediate values\r\n            return ((homeValue * 0.01695) \/ 1000).toFixed(2) * 1000;\r\n        }\r\n\r\n        function updateValues() {\r\n            const homeValue = parseInt(homeValueSlider.value, 10);\r\n\r\n            \/\/ Update the input field to match slider value\r\n            homeValueInput.value = `$${homeValue.toLocaleString()}`;\r\n\r\n            \/\/ Update savings\r\n            savingsDisplay.textContent = calculateSavings(homeValue).toLocaleString();\r\n        }\r\n\r\n        function handleCustomPriceInput() {\r\n            let customPrice = homeValueInput.value.replace(\/\\D\/g, ''); \/\/ Remove non-numeric characters\r\n            if (customPrice) {\r\n                homeValueSlider.value = parseInt(customPrice, 10) || 100000; \/\/ Sync slider temporarily\r\n                savingsDisplay.textContent = calculateSavings(parseInt(customPrice, 10)).toLocaleString();\r\n            }\r\n        }\r\n\r\n        function finalizeInputValue() {\r\n            let customPrice = parseInt(homeValueInput.value.replace(\/\\D\/g, ''), 10) || 100000;\r\n\r\n            \/\/ Enforce min\/max range\r\n            const minPrice = parseInt(homeValueSlider.min, 10);\r\n            const maxPrice = parseInt(homeValueSlider.max, 10);\r\n\r\n            if (customPrice < minPrice) customPrice = minPrice;\r\n            if (customPrice > maxPrice) customPrice = maxPrice;\r\n\r\n            \/\/ Update slider, input field, and savings\r\n            homeValueSlider.value = customPrice;\r\n            homeValueInput.value = `$${customPrice.toLocaleString()}`;\r\n            savingsDisplay.textContent = calculateSavings(customPrice).toLocaleString();\r\n        }\r\n\r\n        \/\/ Initialize values on page load\r\n        window.onload = updateValues;\r\n    <\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f7e136d elementor-widget-divider--view-line elementor-widget elementor-widget-divider\" data-id=\"f7e136d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"divider.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-divider\">\n\t\t\t<span class=\"elementor-divider-separator\">\n\t\t\t\t\t\t<\/span>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-4ff26b6 e-flex e-con-boxed e-con e-parent\" data-id=\"4ff26b6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-97eace2 elementor-widget elementor-widget-heading\" data-id=