an>$3M<\/span>\r\n            <\/div>\r\n        <\/div>\r\n\r\n        <div class=\"input-group\">\r\n            <label for=\"cashback\" class=\"label\">Cashback \/ Savings<\/label>\r\n            <div id=\"cashback\" class=\"output\">~$2,250<\/div>\r\n        <\/div>\r\n        \r\n        <div class=\"commission-section\">\r\n            Buyer's Agent Commission: \r\n            <input type=\"number\" id=\"commission\" class=\"input-field\" value=\"2.5\" oninput=\"validateCommission()\"\u00a0\/> %\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <script>\r\n        const homePriceDisplay = document.getElementById('homePriceDisplay');\r\n        const slider = document.getElementById('price-slider');\r\n        const cashbackOutput = document.getElementById('cashback');\r\n        const commissionInput = document.getElementById('commission');\r\n\r\n        function updateValues() {\r\n            const homePrice = parseInt(slider.value, 10);\r\n\r\n            \/\/ Update the input field to match slider value\r\n            homePriceDisplay.value = `$${homePrice.toLocaleString()}`;\r\n\r\n            \/\/ Update cashback based on the slider value\r\n            calculateCashback(homePrice);\r\n        }\r\n\r\n        function handleCustomPriceInput() {\r\n            \/\/ Allow typing freely and sync slider\r\n            let customPrice = homePriceDisplay.value.replace(\/\\D\/g, ''); \/\/ Remove non-numeric characters\r\n            if (customPrice) {\r\n                slider.value = parseInt(customPrice, 10) || 300000; \/\/ Sync slider temporarily\r\n                calculateCashback(parseInt(customPrice, 10)); \/\/ Update cashback\r\n            }\r\n        }\r\n\r\n        function finalizeInputValue() {\r\n            \/\/ Enforce min\/max range and reformat input\r\n            let customPrice = parseInt(homePriceDisplay.value.replace(\/\\D\/g, ''), 10) || 300000;\r\n\r\n            \/\/ Validate the input value\r\n            const minPrice = parseInt(slider.min, 10);\r\n            const maxPrice = parseInt(slider.max, 10);\r\n\r\n            if (customPrice < minPrice) customPrice = minPrice;\r\n            if (customPrice > maxPrice) customPrice = maxPrice;\r\n\r\n            \/\/ Update slider, input field, and cashback\r\n            slider.value = customPrice;\r\n            homePriceDisplay.value = `$${customPrice.toLocaleString()}`;\r\n            calculateCashback(customPrice);\r\n        }\r\n\r\n        function validateCommission() {\r\n    let commission = parseFloat(commissionInput.value);\r\n\r\n    \/\/ Ensure commission is a valid positive number\r\n    if (isNaN(commission) || commission < 0) {\r\n        commissionInput.value = 2; \/\/ Default to 2% if invalid\r\n    } else if (commission < 2) {\r\n        commissionInput.value = 2; \/\/ Enforce minimum commission\r\n    }\r\n\r\n    calculateCashback(parseInt(slider.value, 10));\r\n}\r\n\r\nfunction calculateCashback(homePrice) {\r\n    let commission = parseFloat(commissionInput.value);\r\n    commission = Math.max(commission, 2.0); \/\/ Ensure minimum commission\r\n\r\n    \/\/ Calculate cashback (50% of commission % of home price)\r\n    let cashback = homePrice * (commission \/ 100) * 0.5;\r\n\r\n    \/\/ Deduct fees based on price range\r\n    let deduction = 0;\r\n    if (homePrice >= 300000 && homePrice <= 799999) deduction = 1500;\r\n    else if (homePrice >= 800000 && homePrice <= 999999) deduction = 3000;\r\n    else if (homePrice >= 1000000 && homePrice <= 2499999) deduction = 3500;\r\n\r\n    cashback = Math.max(cashback - deduction, 0); \/\/ Ensure cashback is not negative\r\n\r\n    \/\/ Update the cashback output\r\n    cashbackOutput.textContent = `~$${cashback.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\r\n}\r\n\r\n\r\n        \/\/ Initialize values on page load\r\n        window.onload = updateValues;\r\n    <\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t