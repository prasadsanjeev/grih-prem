r = document.getElementById('homeValueSlider');\r\n    const savingsValue = document.getElementById('savingsValue');\r\n\r\n    function updateValues() {\r\n        const homeValue = parseInt(homeValueSlider.value, 10);\r\n\r\n        \/\/ Update the input field to match slider value\r\n        homeValueInput.value = `$${homeValue.toLocaleString()}`;\r\n\r\n        \/\/ Update savings\r\n        calculateSavings(homeValue);\r\n    }\r\n\r\n    function handleCustomPriceInput() {\r\n        let customPrice = homeValueInput.value.replace(\/\\D\/g, ''); \/\/ Remove non-numeric characters\r\n        if (customPrice) {\r\n            homeValueSlider.value = parseInt(customPrice, 10) || baseValue; \/\/ Sync slider temporarily\r\n            calculateSavings(parseInt(customPrice, 10)); \/\/ Update savings\r\n        }\r\n    }\r\n\r\n    function finalizeInputValue() {\r\n        let customPrice = parseInt(homeValueInput.value.replace(\/\\D\/g, ''), 10) || baseValue;\r\n\r\n        \/\/ Ensure value is within slider's min\/max range\r\n        const minPrice = parseInt(homeValueSlider.min, 10);\r\n        const maxPrice = parseInt(homeValueSlider.max, 10);\r\n\r\n        if (customPrice < minPrice) customPrice = minPrice;\r\n        if (customPrice > maxPrice) customPrice = maxPrice;\r\n\r\n        \/\/ Update slider and input field\r\n        homeValueSlider.value = customPrice;\r\n        homeValueInput.value = `$${customPrice.toLocaleString()}`;\r\n\r\n        \/\/ Update savings\r\n        calculateSavings(customPrice);\r\n    }\r\n\r\n    function calculateSavings(homeValue) {\r\n        const increments = (homeValue - baseValue) \/ incrementStep;\r\n        const savings = baseSavings + increments * savingsIncrement;\r\n\r\n        \/\/ Update savings display\r\n        savingsValue.textContent = `$${savings.toLocaleString(undefined, {\r\n            minimumFractionDigits: 2,\r\n            maximumFractionDigits: 2,\r\n        })}`;\r\n    }\r\n\r\n    \/\/ Initialize values on page load\r\n    window.onload = updateValues;\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-948c956 elementor-widget__width-initial elementor-widget elementor-widget-text-editor\" data-id=\"948c956\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<section class=\"elementor-section elementor-top-section elementor-element elementor-element-1d8b67d elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"1d8b67d\" data-element_type=\"section\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\"><div class=\"elementor-container elementor-column-gap-default\"><div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-b62ba8f\" data-id=\"b62ba8f\" data-element_type=\"column\"><div class=\"elementor-widget-wrap elementor-element-populated\"><div class=\"elementor-element elementor-element-0a2788d elementor-widget elementor-widget-heading animated fadeInUp\" data-id=\"0a2788d\" data-element_type=\"widget\" data-settings=\"{&quot;_animation&quot;:&quot;fadeInUp&quot;,&quot;_animation_delay&quot;:300}\" data-widget_type=\"heading.default\"><div class=\"elementor-widget-container\"><div class=\"elementor-heading-title elementor-size-default\">How much could you save in commission selling with GRiH compared to a 5% commission? For properties sold below $530,000 will be a flat rate of 2.0% + $3975<\/div><\/div><\/div><\/div><\/div><\/div><\/section><section class=\"elementor-section elementor-top-section elementor-element elementor-element-0c1d306 elementor-section-full_width elementor-section-height-default elementor-section-height-default\" data-id=\"0c1d306\" data-element_type=\"section\"><div class=\"elementor-container elementor-column-gap-default\"><div class=\"elementor-